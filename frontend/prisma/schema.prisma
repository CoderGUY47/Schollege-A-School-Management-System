datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("STUDENT") // ADMIN, TEACHER, STUDENT
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions            Session[]
  accounts            Account[]
  teachingSubjects    Subject[]          @relation("TeacherSubjects")
  enrollments         Enrollment[]
  createdAssignments  Assignment[]       @relation("TeacherAssignments")
  submissions         Submission[]       @relation("StudentSubmissions")
  gradedSubmissions   Submission[]       @relation("GradedSubmissions")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model ClassCourse {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subjects    Subject[]
  enrollments Enrollment[]
  assignments Assignment[]

  @@map("class_course")
}

model Subject {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  classId     String
  class       ClassCourse @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     User?       @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("subject")
}

model Enrollment {
  id         String      @id @default(cuid())
  studentId  String
  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      ClassCourse @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrolledAt DateTime    @default(now())

  @@unique([studentId, classId])
  @@map("enrollment")
}

model Assignment {
  id          String      @id @default(cuid())
  title       String
  description String
  maxMarks    Int         @default(100)
  dueDate     DateTime
  status      String      @default("DRAFT") // DRAFT, PUBLISHED
  classId     String
  class       ClassCourse @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User        @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  submissions Submission[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("assignment")
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  content      String
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  status       String     @default("SUBMITTED") // SUBMITTED, GRADED, RESUBMITTED
  marks        Float?
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  gradedBy     User?      @relation("GradedSubmissions", fields: [gradedById], references: [id], onDelete: SetNull)
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@map("submission")
}

model NoticeBoard {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   @default("GENERAL") // GENERAL, SPORTS, EVENT, EXAM
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notice_board")
}

model FinancialTelemetry {
  id        String   @id @default(cuid())
  month     String
  income    Float
  expense   Float
  year      Int      @default(2026)
  createdAt DateTime @default(now())

  @@map("financial_telemetry")
}

model FinancialTransaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  payerName     String
  type          String
  method        String
  amount        Float
  status        String   @default("COMPLETED") // COMPLETED, PENDING, OVERDUE
  date          DateTime @default(now())

  @@map("financial_transaction")
}

model AdminTodo {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_todo")
}
